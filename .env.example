# MySQL connection — the app has no embedded/mock database; every read and
# write goes through this real MySQL server (server/db.mjs). The schema (all
# tables) is created automatically on first boot — the "urban" database
# itself must already exist, but its tables do not.
# Matches the local WAMP MySQL server already running on this machine
# (verified working against the real "urban" database during the migration).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=urban

# DB_HOST=mysql-39bf04d2-urban-2026.e.aivencloud.com
# DB_PORT=22299
# DB_USER=avnadmin
# DB_PASSWORD=AVNS_dPp5shvg1Vu1TllfIUq
# DB_NAME=defaultdb

# Payment environment — "sandbox" or "production". This is the ONLY thing
# that should change when going live; see server/payment-config-guard.mjs,
# which refuses to boot if this disagrees with the actual Stripe key type
# below (a live sk_live_ key with PAYMENT_ENV=sandbox, or a test sk_test_
# key with PAYMENT_ENV=production).
PAYMENT_ENV=sandbox

# Admin panel login (the account is created automatically the first time the server starts).
# This is the same real Zoho mailbox used to authenticate SMTP below and to receive
# internal admin notification email — see the SMTP section for why.
ADMIN_EMAIL=admin@urbanphoenix.am
ADMIN_PASSWORD=ChangeMe123!

# Secret used to sign admin/customer session tokens. Must stay private — anyone with
# this value can forge valid login tokens for any account, including admin.
JWT_SECRET=ed2f8686f6b065920de4ee6c2156b4906a6a130e1ba31d53a2980c114862fa9dbc4f9ddeec7564dae436450b54f0eeff

# Port the server listens on.
PORT=4173

# Public URL of your site, used to build email verification links.
# Set this to your real domain once deployed (e.g. https://urbanphoenix.am).
PUBLIC_URL=https://urbanphoenix.am

# Stripe (card payments) — server/payment/providers/stripe.mjs. Get sandbox/
# test-mode keys from https://dashboard.stripe.com/test/apikeys (sk_test_.../
# pk_test_...). For local sandbox testing, forward webhooks with the Stripe
# CLI: `stripe listen --forward-to localhost:5173/api/stripe/webhook` and
# paste the "whsec_..." it prints below. When going live, replace these three
# with the live-mode equivalents (sk_live_.../pk_live_...) from
# https://dashboard.stripe.com/apikeys and set PAYMENT_ENV=production above —
# nothing else in the codebase needs to change.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Idram wallet — server/payment/providers/idram.mjs. URLs registered with
# Idram (set on their side, not here):
#   SUCCESS_URL https://urbanphoenix.am/payment/success
#   FAIL_URL    https://urbanphoenix.am/payment/fail
#   RESULT_URL  https://urbanphoenix.am/payment/idram-result
# The Idram option appears at checkout only when both the account and the
# secret key are set. The secret key goes in the real .env ONLY — never here.
IDRAM_REC_ACCOUNT=100075164
IDRAM_SECRET_KEY=
IDRAM_EMAIL=admin@urbanphoenix.am

# ArCa card payments (Visa / Mastercard / ArCa) — server/payment/providers/arca.mjs,
# per ArCa's "EPG – Merchant Integration Guide". When the user name and
# password are both set, the checkout's card option sends the customer to
# ArCa's own payment page (card details never touch this server) instead of
# the Stripe form. The bank gives a separate user/password for the TEST and
# the LIVE gateway — they go in the real .env ONLY, never here.
# Return URL (sent automatically with every payment, built from PUBLIC_URL):
#   https://urbanphoenix.am/payment/arca/return
# ARCA_API_URL is the "API URL" the bank gave (empty = ArCa's public TEST
# gateway https://ipaytest.arca.am:8445/payment/rest).
# ARCA_USERNAME / ARCA_PASSWORD are the bank's "_api" login — NOT the "_web"
# login, which is only for the merchant portal https://epg.arca.am/epg_gui/
# (transaction history, refunds by hand).
ARCA_API_URL=https://ipayproxy.idp.am/payment/rest
ARCA_USERNAME=
ARCA_PASSWORD=
# 3-D Secure: every payment is registered with features=FORCE_TDS ("processed
# as 3DS2"), so after the card form the customer gets the bank's code page.
# Set to false only if the bank says your merchant has no 3DS2 permission.
ARCA_FORCE_3DS=true

# SMTP settings — Zoho Mail (EU data center), used to send all transactional
# email (verification codes, password resets, order confirmations, contact
# form, order status updates). support@urbanphoenix.am is a verified alias on
# this mailbox — Zoho requires authenticating as the real mailbox (admin@)
# and sends as the alias only via the "from" address, so SMTP_USER must stay
# admin@urbanphoenix.am even though most outgoing mail is "from" support@
# (see server/mailer.mjs's EMAIL_SENDERS).
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@urbanphoenix.am
# Paste your Zoho App Password below (Zoho Mail > Settings > Security > App
# Passwords) — never a real account password. This value must never be
# committed, logged, or pasted into chat.
SMTP_PASS=your-zoho-app-password
SUPPORT_EMAIL=support@urbanphoenix.am

# ZeptoMail (Zoho's transactional email API) — use this on the production
# server: DigitalOcean blocks outgoing SMTP ports 465/587, so the SMTP
# settings above can't connect there. When set, ALL email is sent over HTTPS
# through ZeptoMail instead of SMTP. Get it from ZeptoMail > Mail Agents >
# your agent > SMTP/API > API > "Send Mail Token".
ZEPTOMAIL_TOKEN=
# Optional — only for a non-EU ZeptoMail account:
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# ORDERS_EMAIL intentionally left unset: orders@urbanphoenix.am is NOT a
# verified Zoho "Send Mail As" alias for this mailbox (confirmed by a direct
# send test — Zoho returns "553 Sender is not allowed to relay emails" for
# it, while admin@ and support@ both succeed on the same connection). With
# this unset, server/mailer.mjs's EMAIL_SENDERS.orders falls back to
# SMTP_USER (admin@urbanphoenix.am), matching the sender behavior this
# codebase used before the support@/orders@ per-alias split existed — order
# confirmation mail actually delivers. Once orders@ is verified as an alias
# in Zoho Mail (Settings > Mail Delegation / Send Mail As), set
# ORDERS_EMAIL=orders@urbanphoenix.am again to restore that identity.
# With ZEPTOMAIL_TOKEN set (production), any address on urbanphoenix.am can
# be the sender once the domain shows "Verified" in ZeptoMail > Domains, so
# ORDERS_EMAIL=orders@urbanphoenix.am works there without a Zoho alias.
#
# Check/test order confirmation email on any server (sends nothing unless
# you use send/resend/retry):
#   node --env-file=.env scripts/order-email.mjs status

# ---------- Electronic cash register (ՀԴՄ / HDM) — server/hdm/ ----------
# Fiscal receipts for verified ArCa/Idram payments, sent to the State Revenue
# Committee (SRC) web service over mutual TLS. Keep HDM_ENABLED=false until
# the register is active, departments are configured and every business
# setting below is confirmed (scripts/hdm.mjs check / probe).
HDM_ENABLED=false
HDM_CRN=52472841
HDM_TIN=28028252
HDM_BASE_URL=https://ecrm.taxservice.am/taxsystem-rs-vcr
# Certificate files live OUTSIDE the app folder and outside git, readable
# only by the service user (see deployment notes), e.g. /etc/urban-phoenix/hdm/
HDM_PFX_PATH=/etc/urban-phoenix/hdm/28028252_52472841.p12
HDM_CA_PATH=/etc/urban-phoenix/hdm/ca_645b34a4865e7.crt
# Secret — set only in the server's .env, never here or in git.
HDM_PFX_PASSPHRASE=
# Payment providers that get a receipt (verified online payments only).
HDM_PROVIDERS=arca,idram
# Business settings — must be confirmed by the business/accountant. Receipts
# stay "blocked" (with the reason shown in Admin → Orders) until set:
HDM_TAX_REGIME=
HDM_DEPARTMENT=
HDM_ADG_CODE=
HDM_CASHIER_ID=
HDM_UNIT=
# Only needed if delivery is charged (US/Russia orders): delivery as its own line.
HDM_SHIPPING_ADG_CODE=
# HDM_SHIPPING_GOOD_CODE=DELIVERY
# HDM_SHIPPING_GOOD_NAME=Առաքում
# HDM_SHIPPING_DEPARTMENT=
# Only needed if promo codes / UP Society points are used: line_total spreads
# the order discount over the item lines (SRC discountType 4).
HDM_DISCOUNT_MODE=
# Receipt numbers below this are ignored by reconciliation (e.g. test
# receipts issued on this register before the website went live).
# HDM_RECEIPT_ID_FLOOR=0
