# MySQL connection — the app has no embedded/mock database; every read and
# write goes through this real MySQL server (server/db.mjs). The schema (all
# tables) is created automatically on first boot — the "urban" database
# itself must already exist, but its tables do not.
# Matches the local WAMP MySQL server already running on this machine
# (verified working against the real "urban" database during the migration).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=urban

# DB_HOST=mysql-39bf04d2-urban-2026.e.aivencloud.com
# DB_PORT=22299
# DB_USER=avnadmin
# DB_PASSWORD=AVNS_dPp5shvg1Vu1TllfIUq
# DB_NAME=defaultdb

# Payment environment — "sandbox" or "production". This is the ONLY thing
# that should change when going live; see server/payment-config-guard.mjs,
# which refuses to boot if this disagrees with the actual Stripe key type
# below (a live sk_live_ key with PAYMENT_ENV=sandbox, or a test sk_test_
# key with PAYMENT_ENV=production).
PAYMENT_ENV=sandbox

# Admin panel login (the account is created automatically the first time the server starts).
# This is the same real Zoho mailbox used to authenticate SMTP below and to receive
# internal admin notification email — see the SMTP section for why.
ADMIN_EMAIL=admin@urbanphoenix.am
ADMIN_PASSWORD=ChangeMe123!

# Secret used to sign admin/customer session tokens. Must stay private — anyone with
# this value can forge valid login tokens for any account, including admin.
JWT_SECRET=ed2f8686f6b065920de4ee6c2156b4906a6a130e1ba31d53a2980c114862fa9dbc4f9ddeec7564dae436450b54f0eeff

# Port the server listens on.
PORT=4173

# Public URL of your site, used to build email verification links.
# Set this to your real domain once deployed (e.g. https://urbanphoenix.am).
PUBLIC_URL=https://urbanphoenix.am

# Stripe (card payments) — server/payment/providers/stripe.mjs. Get sandbox/
# test-mode keys from https://dashboard.stripe.com/test/apikeys (sk_test_.../
# pk_test_...). For local sandbox testing, forward webhooks with the Stripe
# CLI: `stripe listen --forward-to localhost:5173/api/stripe/webhook` and
# paste the "whsec_..." it prints below. When going live, replace these three
# with the live-mode equivalents (sk_live_.../pk_live_...) from
# https://dashboard.stripe.com/apikeys and set PAYMENT_ENV=production above —
# nothing else in the codebase needs to change.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP settings — Zoho Mail (EU data center), used to send all transactional
# email (verification codes, password resets, order confirmations, contact
# form, order status updates). support@urbanphoenix.am is a verified alias on
# this mailbox — Zoho requires authenticating as the real mailbox (admin@)
# and sends as the alias only via the "from" address, so SMTP_USER must stay
# admin@urbanphoenix.am even though most outgoing mail is "from" support@
# (see server/mailer.mjs's EMAIL_SENDERS).
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@urbanphoenix.am
# Paste your Zoho App Password below (Zoho Mail > Settings > Security > App
# Passwords) — never a real account password. This value must never be
# committed, logged, or pasted into chat.
SMTP_PASS=TKgQ9jFfYiqx
SUPPORT_EMAIL=support@urbanphoenix.am
# ORDERS_EMAIL intentionally left unset: orders@urbanphoenix.am is NOT a
# verified Zoho "Send Mail As" alias for this mailbox (confirmed by a direct
# send test — Zoho returns "553 Sender is not allowed to relay emails" for
# it, while admin@ and support@ both succeed on the same connection). With
# this unset, server/mailer.mjs's EMAIL_SENDERS.orders falls back to
# SMTP_USER (admin@urbanphoenix.am), matching the sender behavior this
# codebase used before the support@/orders@ per-alias split existed — order
# confirmation mail actually delivers. Once orders@ is verified as an alias
# in Zoho Mail (Settings > Mail Delegation / Send Mail As), set
# ORDERS_EMAIL=orders@urbanphoenix.am again to restore that identity.
