# Set to "production" when running a real deployment (node server.mjs / npm run serve).
# Leave unset for local development — some safety checks below only apply when this is "production".
NODE_ENV=production

# MySQL connection — this app has no embedded/mock database; every read and
# write goes through this real MySQL server (server/db.mjs). DB_NAME defaults
# to "urban" if left unset. The schema (all tables) is created automatically
# on first boot against whatever database DB_NAME points at — it must already
# exist (CREATE DATABASE urban;), but its tables do not.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=urban

# Payment environment — "sandbox" (default) or "production". This is the
# ONLY setting that should change when moving this site to production; see
# server/payment-config-guard.mjs, which refuses to start the server if this
# disagrees with the actual Stripe key type configured below (e.g. a live
# sk_live_ key with PAYMENT_ENV=sandbox, or a test sk_test_ key with
# PAYMENT_ENV=production).
PAYMENT_ENV=sandbox

# Admin panel login (the account is created automatically the first time the server starts).
# Change these before your first launch. If NODE_ENV=production and ADMIN_PASSWORD is left at
# this documented default, the server refuses to start — see server/admin-config-guard.mjs.
# This is the same real mailbox used to authenticate SMTP below — see the SMTP section.
ADMIN_EMAIL=admin@urbanphoenix.am
ADMIN_PASSWORD=ChangeMe123!

# Controls how many reverse-proxy hops (if any) Express trusts when reading the client's real IP
# from X-Forwarded-For — used by the rate limiter. Leave unset for local dev / no proxy in front
# of this app. Set to "1" for a single reverse proxy/load balancer directly in front of it (most
# common setup). See the comment in server/app.mjs for every accepted value and when to use it.
TRUST_PROXY=

# Secret used to sign admin session tokens. Set this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Port the server listens on.
PORT=4173

# Public URL of your site, used to build email verification links.
# Set this to your real domain once deployed (e.g. https://urbanphoenix.am).
PUBLIC_URL=http://localhost:4173

# Stripe (card payments) — server/payment/providers/stripe.mjs, orchestrated
# through server/payment/paymentService.mjs. Without these set, choosing
# "Card" at checkout returns a clear error instead of silently creating an
# unpaid order.
#
# Sandbox/test-mode keys: https://dashboard.stripe.com/test/apikeys (sk_test_.../pk_test_...).
# For local sandbox testing, forward webhooks with the Stripe CLI:
#   stripe listen --forward-to localhost:5173/api/stripe/webhook
# and put the "whsec_..." it prints into STRIPE_WEBHOOK_SECRET.
#
# Going live: replace all three with the LIVE-mode equivalents from
# https://dashboard.stripe.com/apikeys (sk_live_.../pk_live_...), add a
# webhook endpoint in the Stripe Dashboard (Developers > Webhooks) pointed at
# https://yourdomain.com/api/stripe/webhook listening for
# "payment_intent.succeeded", and set PAYMENT_ENV=production above — the
# checkout/order/delivery code itself never needs to change.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP settings — Zoho Mail (EU data center). If left blank, verification codes/reset
# links are printed to the server console instead of emailed, so you can still test
# registration end-to-end without an email provider configured.
#
# support@ and orders@ are aliases on the same Zoho mailbox as admin@, not separate
# SMTP accounts — Zoho requires authenticating as the real mailbox and sends "from"
# an alias only via the From header, so SMTP_USER must stay the admin@ address even
# though most outgoing mail uses SUPPORT_EMAIL/ORDERS_EMAIL as the From identity
# (see server/mailer.mjs's EMAIL_SENDERS and the routing rules in its comments).
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@urbanphoenix.am
# Paste a Zoho App Password here (Zoho Mail > Settings > Security > App Passwords) —
# never your real account password, and never commit a real value in this file.
SMTP_PASS=
SUPPORT_EMAIL=support@urbanphoenix.am
ORDERS_EMAIL=orders@urbanphoenix.am
