# Dependencies
node_modules/

# Build output
dist/

# Runtime data — SQLite database (WAL/SHM included), generated JWT signing
# secret, and admin-uploaded media. Never contains anything that belongs in
# version control; regenerated/seeded automatically on first run.
data/
# ...but src/data/ is app source code (category/currency config etc.), not runtime data.
!src/data/

# Environment variables — real secrets (SMTP password, Stripe keys, JWT
# secret, admin credentials) live here. .env.example is the tracked,
# secret-free template; only the real .env must never be committed.
.env
.env.local
.env.*.local

# Test artifacts
test-results/
playwright-report/
blob-report/
coverage/

# Logs
*.log
npm-debug.log*

# Editor/OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Resized WebP copies generated by server/image-variants.mjs
public/uploads/.variants/

# Local preview written by scripts/order-email.mjs
order-email-preview.html

# Electronic cash register (HDM) private material — never commit. These
# files belong in a private folder on the server (/etc/urban-phoenix/hdm).
*.p12
*.pfx
*.jks
*.key
KEYSTORE_PASSWORD.txt
28028252_*
*HDM_INTEGRATION*
*HDM_PRIVATE*

# Local backups of .env (contain secrets) — never commit
.env.bak*
